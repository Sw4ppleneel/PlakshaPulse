{
  "name": "plaksha-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "sweep": "tsx scripts/sweep.ts",
    "e2e": "node tools/e2e.mjs",
    "security:check": "node tools/attack.mjs && node tools/attack-replay.mjs",
    "demo:video": "node tools/demo-video.mjs",
    "shots": "node tools/shots.mjs",
    "vercel-build": "tsx scripts/migrate.ts && tsx scripts/seed.ts && next build"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "clsx": "2.1.1",
    "d3-force": "3.0.1",
    "d3-quadtree": "3.0.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.71.0",
    "motion": "14.12.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "rate-limiter-flexible": "11.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/d3-force": "3.0.10",
    "@types/d3-quadtree": "3.0.6",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
