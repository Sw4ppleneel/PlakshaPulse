DATABASE_URL=postgres://user:pass@localhost:5432/pulse
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://pulse.example.edu
# Only accounts on this domain can sign in (checked server-side on every sign-in).
ALLOWED_EMAIL_DOMAIN=plaksha.edu.in
# Comma-separated emails that become admins on first sign-in.
ADMIN_EMAILS=
# Microsoft Entra ID (Plaksha's Microsoft 365 tenant). Leave client id/secret blank to use email codes only.
# Register a single-tenant app; redirect URI: <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_TENANT_ID=45798c33-1b43-4c01-bf3e-d8d655d3389c
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# SMTP connection string for one-time sign-in codes, e.g. smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="Plaksha Pulse <pulse@plaksha.edu.in>"
